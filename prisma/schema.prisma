// ═══════════════════════════════════════════════════════════════════════════════
//  BOUNDED CONTEXT: COMMERCIAL DOCUMENTS  (migration 011)
//
//  Quotations, orders and returns are paperwork, not accounting. None of them moves
//  the ledger, so they live apart from `Document` — which carries the ZATCA hash
//  chain, the posting trigger and the paid/allocated invariants, and whose every row
//  is expected to become a journal. See the head of migration 011 for the argument.
// ═══════════════════════════════════════════════════════════════════════════════

/// Credit terms offered to a counterparty.
///
/// Not yet consulted when an invoice computes its due date — see migration 011. The
/// screen maintains the catalogue; wiring it into invoicing would change the ageing
/// of every existing customer, which is a business decision rather than a schema one.
model PaymentTerm {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  code            String   @db.VarChar(32)
  nameAr          String   @db.VarChar(128)
  nameEn          String   @db.VarChar(128)
  /// Days from invoice date to due date. Zero is cash on delivery.
  netDays         Int      @default(0)
  /// Both or neither: a discount percentage with no deadline is a permanent price cut.
  discountDays    Int?
  discountPercent Decimal? @db.Decimal(9, 4)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("payment_terms")
}

/// A maintained price catalogue.
///
/// Deliberately not read at invoicing: the invoice screen still uses the product's
/// `salePrice`. This is a catalogue, not a pricing engine.
model PriceList {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  code      String    @db.VarChar(32)
  nameAr    String    @db.VarChar(128)
  nameEn    String    @db.VarChar(128)
  currency  String    @db.Char(3)
  validFrom DateTime  @db.Date
  /// NULL is open-ended, which is the common case for a standard list.
  validTo   DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines  PriceListLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("price_lists")
}

model PriceListLine {
  id          String  @id @default(uuid()) @db.Uuid
  /// Denormalised from the list so this table can carry a policy of its own; a
  /// trigger (migration 009's generic guard) refuses any row whose tenant disagrees.
  tenantId    String  @db.Uuid
  priceListId String  @db.Uuid
  productId   String  @db.Uuid
  unitPrice   Decimal @db.Decimal(19, 4)
  /// A quantity break: this price applies from this quantity upward.
  minQuantity Decimal @default(1) @db.Decimal(19, 4)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([priceListId, productId, minQuantity])
  @@index([tenantId])
  @@index([tenantId, priceListId])
  @@map("price_list_lines")
}

/// A quotation, sales order, purchase order or sales return.
///
/// One table for four documents because they are the same shape — a counterparty,
/// some dates, some priced lines — and the only thing that differs is what the
/// document means. Four tables would be four places for the same rule to drift.
///
/// **Confirming one posts nothing.** No stock is reserved, no receivable raised, no
/// journal written. The conversion paths (quotation → order → invoice) are not built.
model TradeDocument {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  type           TradeDocumentType
  status         TradeDocumentStatus @default(DRAFT)
  documentNumber String              @db.VarChar(32)
  counterpartyId String              @db.Uuid
  branchId       String              @db.Uuid
  documentDate   DateTime            @db.Date
  /// A quotation's validity, an order's promised delivery — the same question.
  expectedDate   DateTime?           @db.Date
  currency       String              @default("SAR") @db.Char(3)
  /// Derived from the lines and stored so the register need not aggregate every line
  /// of every document to draw one page.
  subtotal       Decimal             @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal             @default(0) @db.Decimal(19, 4)
  totalAmount    Decimal             @default(0) @db.Decimal(19, 4)
  notes          String?             @db.VarChar(1024)
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  counterparty Counterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines        TradeDocumentLine[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, type, documentDate])
  @@index([tenantId, counterpartyId])
  @@map("trade_documents")
}

/// A priced line. Immutable once its document leaves DRAFT — trigger-enforced,
/// because a confirmed order is what the customer agreed to.
model TradeDocumentLine {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  documentId      String  @db.Uuid
  lineNumber      Int
  productId       String  @db.Uuid
  description     String? @db.VarChar(512)
  quantity        Decimal @db.Decimal(19, 4)
  unitPrice       Decimal @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(9, 4)
  taxRate         Decimal @default(0) @db.Decimal(9, 4)
  lineTotal       Decimal @default(0) @db.Decimal(19, 4)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([documentId, lineNumber])
  @@index([tenantId])
  @@index([tenantId, documentId])
  @@map("trade_document_lines")
}

/// An instruction to build `quantity` of `product` from the component lines.
///
/// **Completing one does not move stock.** Components are not consumed and the output
/// is not received: doing that correctly means costing the assembled item from its
/// components' cost layers, which is the deepest change on this release's list. The
/// order records the intent and its status; the movements are a seam, not a feature.
model AssemblyOrder {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  orderNumber String         @db.VarChar(32)
  status      AssemblyStatus @default(DRAFT)
  productId   String         @db.Uuid
  quantity    Decimal        @db.Decimal(19, 4)
  warehouseId String         @db.Uuid
  branchId    String         @db.Uuid
  orderDate   DateTime       @db.Date
  notes       String?        @db.VarChar(1024)
  createdById String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  completedAt DateTime?      @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product   Product             @relation("AssemblyOutput", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines     AssemblyOrderLine[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("assembly_orders")
}

model AssemblyOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  assemblyOrderId String  @db.Uuid
  productId       String  @db.Uuid
  /// Per ONE unit of output. The total consumed is this times the order quantity,
  /// computed where it is read rather than stored twice and allowed to disagree.
  quantityPerUnit Decimal @db.Decimal(19, 4)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order   AssemblyOrder @relation(fields: [assemblyOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([assemblyOrderId, productId])
  @@index([tenantId])
  @@index([tenantId, assemblyOrderId])
  @@map("assembly_order_lines")
}

enum TradeDocumentType {
  QUOTATION
  SALES_ORDER
  PURCHASE_ORDER
  SALES_RETURN
}

enum TradeDocumentStatus {
  DRAFT
  /// Held by an approval rule. Lines are frozen — a document under review is precisely one
  /// whose terms must not move under the reviewer.
  PENDING_APPROVAL
  /// Agreed with the counterparty. Lines are frozen from here on.
  CONFIRMED
  /// Fulfilled — invoiced, delivered, or received. Terminal.
  COMPLETED
  CANCELLED
}

enum AssemblyStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ApprovalConditionField {
  TOTAL_AMOUNT
  SUBTOTAL
  TAX_AMOUNT
  LINE_COUNT
  /// The largest per-line discount on the document, as a percentage.
  MAX_LINE_DISCOUNT_PERCENT
  // ── Counterparty facts (migration 014) ────────────────────────────────────
  // Credit control asks about the *customer*, not the document: "block a sales order for a
  // customer more than 60 days overdue" is not a fact about the order. Added to this enum
  // rather than a parallel one so a single rule can mix both — "total over 50,000 AND overdue
  // over 60 days" is one rule, evaluated once.
  /// Age in days of the customer's oldest unpaid invoice, past its grace period.
  OVERDUE_DAYS
  /// Total outstanding on invoices past due beyond the grace period.
  OVERDUE_AMOUNT
  /// Outstanding balance as a percentage of the credit limit. Uncapped — 300% is real.
  CREDIT_EXPOSURE_PERCENT
}

enum ApprovalConditionOperator {
  GT
  GTE
  LT
  LTE
  EQ
  NEQ
}

/// Collections policy for one customer.
///
/// **Deliberately does not carry a `creditLimit`.** `counterparties.creditLimit` already exists
/// and is what the ageing report, the customer card and the field-level permission set read.
/// A second column for the same concept means every screen has to pick one, and they disagree
/// the first time somebody updates either — silently. The profile holds the *terms*; the limit
/// stays where the rest of the system already looks.
model CustomerCreditProfile {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  counterpartyId String   @unique @db.Uuid
  /// Days after the due date before an invoice counts as delinquent. Distinct from
  /// `PaymentTerm.netDays`, which decides when it becomes *due* — one is negotiated with the
  /// customer, the other is set by whoever owns collections.
  graceDays      Int      @default(0)
  /// The age at which the system stops letting new orders through unreviewed.
  holdAfterDays  Int      @default(60)
  /// A manual override that outranks the arithmetic: a customer in dispute is blocked whatever
  /// the numbers say. The CHECK requires a reason, so a block is always liftable by someone
  /// who can see why it exists.
  isBlocked      Boolean  @default(false)
  blockReason    String?  @db.VarChar(512)
  notes          String?  @db.VarChar(1024)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@map("customer_credit_profiles")
}
